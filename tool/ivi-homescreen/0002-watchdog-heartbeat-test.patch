+
+# Watchdog liveness must be driven by the App heartbeat pets, not by frame
+# production: a hidden launcher parks vsync and renders nothing for minutes at
+# a time and must never trip the abort. Links homescreen_ut_shell for the
+# singleton and its logging, as the other shell-unit tests do.
+set(TESTCASE_NAME "homescreen_watchdog_heartbeat_ut_test_driver")
+
+add_executable(${TESTCASE_NAME} test_case_watchdog_heartbeat.cc)
+add_sanitizers(${TESTCASE_NAME})
+target_compile_definitions(${TESTCASE_NAME}
+        PRIVATE SOURCE_ROOT_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
+target_link_libraries(${TESTCASE_NAME} PRIVATE gtest_main homescreen_ut_shell)
+if (BUILD_BACKEND_WAYLAND_EGL)
+    target_link_libraries(${TESTCASE_NAME} PRIVATE PkgConfig::EGL)
+endif ()
+
+add_test(
+        NAME ${TESTCASE_NAME}
+        COMMAND ${TESTCASE_NAME}
+)
+
+# The heartbeat case runs for 3x the configured timeout, so give it room on a
+# loaded builder.
+set_tests_properties(${TESTCASE_NAME} PROPERTIES TIMEOUT 60)
+install(DIRECTORY files DESTINATION ${CMAKE_CURRENT_BINARY_DIR})
