+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// The watchdog must stay satisfied while the app renders nothing.
+//
+// The render thread is NOT petted per frame. App::Run() runs a heartbeat on
+// the main-thread reactor (interval/2, shell/app.cc on_wd_timer) that pets
+// WATCHDOG_SOURCE_MAIN_THREAD directly and, through
+// FlutterView::PetWatchdogViaCallback() -> Engine::PetWatchdogViaCallback()
+// (shell/engine.cc), calls FlutterEnginePostCallbackOnAllNativeThreads, whose
+// callback pets WATCHDOG_SOURCE_RENDER_THREAD when it runs on the raster
+// thread. The engine queues that callback on each thread's task runner
+// (embedder.h: "posted to all threads"), so delivery depends on the thread
+// servicing tasks -- not on a frame being produced.
+//
+// That distinction is load-bearing for the hidden-launcher path: hide parks
+// vsync, so no frame is ever built, rastered or scanned out while a game
+// runs. If watchdog liveness were coupled to frame production, hiding for
+// longer than timeout_ms would abort() the process.
+//
+// The negative control -- a source nobody pets does abort -- already exists
+// as the INTEGRATION_TEST_SYSTEMD_WATCHDOG build (shell/main.cc), which
+// deliberately never pets source 100 and expects the process to die. This
+// test covers the other half: heartbeat-only pets, zero frame activity, for
+// 3x the timeout. If that does not abort, the mechanism the hidden launcher
+// relies on holds.
+//
+// The surviving part is the assertion: gtest finishing IS the check. A
+// failure here is the watchdog's abort(), i.e. a crashed test, not a failed
+// EXPECT.
+
+#include <chrono>
+#include <string>
+#include <thread>
+
+#include <gtest/gtest.h>
+
+#include "shell/watchdog/watchdog.h"
+
+namespace {
+
+constexpr char kConfigPath[] = SOURCE_ROOT_DIR "/files/watchdog_config.toml";
+
+TEST(WatchdogHeartbeat, HeartbeatPetsSurviveThreeTimeoutsWithoutFrames) {
+  const std::string config_path = kConfigPath;
+  Watchdog::init(&config_path);
+  auto& wd = Watchdog::getInstance();
+
+  const uint64_t timeout_ms = wd.getTimeoutMs();
+  ASSERT_EQ(800U, timeout_ms) << "test config not loaded";
+
+  wd.setSourceName(WATCHDOG_SOURCE_MAIN_THREAD, "main_thread");
+  wd.setSourceName(WATCHDOG_SOURCE_RENDER_THREAD, "render_thread");
+  wd.start(WATCHDOG_SOURCE_MAIN_THREAD);
+  wd.start(WATCHDOG_SOURCE_RENDER_THREAD);
+
+  // Mirror App::Run's heartbeat: both sources petted every timeout/8 -- well
+  // inside the service thread's interval/2 check period, as the real timer is
+  // -- while nothing renders. 1/8 rather than the production 1/2 so the test
+  // tolerates scheduler jitter on a loaded builder instead of racing its own
+  // timeout.
+  const auto period = std::chrono::milliseconds(timeout_ms / 8);
+  const auto deadline =
+      std::chrono::steady_clock::now() +
+      std::chrono::milliseconds(static_cast<int64_t>(timeout_ms) * 3);
+
+  while (std::chrono::steady_clock::now() < deadline) {
+    wd.pet(WATCHDOG_SOURCE_MAIN_THREAD);
+    wd.pet(WATCHDOG_SOURCE_RENDER_THREAD);
+    std::this_thread::sleep_for(period);
+  }
+
+  // Reaching here means 3x timeout elapsed with zero frame activity and no
+  // abort.
+  SUCCEED();
+
+  wd.stop(WATCHDOG_SOURCE_RENDER_THREAD);
+  wd.stop(WATCHDOG_SOURCE_MAIN_THREAD);
+  wd.shutdown();
+}
+
+}  // namespace
