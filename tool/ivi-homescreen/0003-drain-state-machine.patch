+TEST(WindowHideState, MinimizeFailureReportsErrorStaysParked) {
+  Hooks hooks;
+  hooks.minimize_ok = false;  // compositor never confirmed minimize
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  auto f = Fire(machine, &WindowHideState::Hide);
+  hooks.DrainAll();
+  hooks.RunDeferred();
+
+  auto r = f.get();
+  EXPECT_EQ(WindowHideState::Outcome::kMinimizeFailed, r.outcome);
+  EXPECT_TRUE(r.parked);
+  EXPECT_FALSE(r.minimized);
+  EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+}
