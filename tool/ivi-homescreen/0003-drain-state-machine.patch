+TEST(WindowHideState, HideJoinsWhileHiding) {
+  Hooks hooks;
+  hooks.inflight_polls.store(2);
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  std::promise<WindowHideState::Result> p2;
+  auto f2 = p2.get_future();
+  machine.Hide([&p2](const WindowHideState::Result& r) { p2.set_value(r); });
+
+  auto f1 = Fire(machine, &WindowHideState::Hide);
+  hooks.DrainAll();
+  hooks.RunDeferred();
+
+  auto r1 = f1.get();
+  auto r2 = f2.get();
+
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r1.outcome);
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r2.outcome);
+  EXPECT_TRUE(r1.parked);
+  EXPECT_EQ(1, hooks.park_calls);       // single park shared by both
+  EXPECT_EQ(1, hooks.minimize_calls);
+}
