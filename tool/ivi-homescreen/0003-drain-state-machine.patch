+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// Unit tests for WindowHideState — the hide/show state machine behind the
+// sigg_launcher/window channel.
+//
+// The machine has no Wayland/Flutter dependencies: every side effect is an
+// injected hook, so these tests run on a plain thread pool with no display,
+// no compositor and no engine attached.
+//
+// Hooks:
+//   park/unpark   : record calls, toggle m_parked.
+//   is_parked     : returns m_parked.
+//   frame_in_flight: returns true while m_inflight_polls > 0, decrementing
+//                    on each PollDrain call.
+//   schedule      : defers fn to a queue; the test drives it with Tick().
+//   minimize/restore: either complete immediately (done() synchronously) or
+//                     defer to a queue, controlled by defer_minimize/defer_restore.
+//                     Deferred completions are run with RunDeferred().
+//
+// Results are collected through std::promise/future. Tests fire an operation,
+// drive the schedule/deferred queues as needed, then .get() the future. This
+// makes hide/show races deterministic: a show issued before the drain ticks
+// lands mid-drain and cancels the hide.
+
+#include <functional>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+#include "shell/view/window_hide_state.h"
+
+using ivi::WindowHideState;
+
+namespace {
+
+struct Hooks {
+  std::atomic<bool> parked_result{true};  // is_parked(): did parking take effect?
+  std::atomic<int> inflight_polls{0};     // frame_in_flight true this many times
+  int park_calls = 0;
+  int unpark_calls = 0;
+  int minimize_calls = 0;
+  int restore_calls = 0;
+  bool defer_minimize = false;
+  bool defer_restore = false;
+  bool minimize_ok = true;
+  bool restore_ok = true;
+  bool minimize_minimized = true;
+  bool restore_minimized = false;
+
+  std::mutex mu;
+  struct Deferred {
+    std::function<void(bool, bool)> done;
+    bool ok;
+    bool minimized;
+  };
+  std::vector<Deferred> deferred;
+  std::vector<std::function<void()>> scheduled;
+
+  void Install(WindowHideState::Hooks& out) {
+    out.park = [this] {
+      std::lock_guard<std::mutex> lock(mu);
+      ++park_calls;
+      // park() requests parking; whether it took effect is reported by
+      // is_parked() (a missing vsync provider leaves it false).
+    };
+    out.unpark = [this] {
+      std::lock_guard<std::mutex> lock(mu);
+      ++unpark_calls;
+      parked_result.store(false, std::memory_order_release);
+    };
+    out.is_parked = [this] { return parked_result.load(std::memory_order_acquire); };
+    out.frame_in_flight = [this] {
+      return inflight_polls.fetch_sub(1, std::memory_order_acq_rel) > 0;
+    };
+    out.schedule = [this](int /*delay_ms*/, std::function<void()> fn) {
+      std::lock_guard<std::mutex> lock(mu);
+      scheduled.push_back(std::move(fn));
+    };
+    out.minimize = [this](std::function<void(bool, bool)> done) {
+      std::lock_guard<std::mutex> lock(mu);
+      ++minimize_calls;
+      if (defer_minimize) {
+        deferred.push_back({std::move(done), minimize_ok, minimize_minimized});
+      } else {
+        done(minimize_ok, minimize_minimized);
+      }
+    };
+    out.restore = [this](std::function<void(bool, bool)> done) {
+      std::lock_guard<std::mutex> lock(mu);
+      ++restore_calls;
+      if (defer_restore) {
+        deferred.push_back({std::move(done), restore_ok, restore_minimized});
+      } else {
+        done(restore_ok, restore_minimized);
+      }
+    };
+  }
+
+  // Run one scheduled drain poll (may schedule more; run until empty to
+  // complete a drain).
+  void TickOne() {
+    std::function<void()> fn;
+    {
+      std::lock_guard<std::mutex> lock(mu);
+      if (scheduled.empty()) {
+        return;
+      }
+      fn = std::move(scheduled.front());
+      scheduled.erase(scheduled.begin());
+    }
+    fn();
+  }
+
+  void DrainAll() {
+    while (true) {
+      std::function<void()> fn;
+      {
+        std::lock_guard<std::mutex> lock(mu);
+        if (scheduled.empty()) {
+          return;
+        }
+        fn = std::move(scheduled.front());
+        scheduled.erase(scheduled.begin());
+      }
+      fn();
+    }
+  }
+
+  void RunDeferred() {
+    std::vector<Deferred> batch;
+    {
+      std::lock_guard<std::mutex> lock(mu);
+      batch.swap(deferred);
+    }
+    for (auto& d : batch) {
+      d.done(d.ok, d.minimized);
+    }
+  }
+};
+
+// Fire an operation, return its future without blocking. The caller drives
+// Tick()/RunDeferred() and then .get()s. The promise is heap-backed so it
+// outlives Fire() — the callback may run later, once the drain/deferred
+// queues are driven.
+std::future<WindowHideState::Result> Fire(WindowHideState& machine,
+                                          void (WindowHideState::*fn)(
+                                              WindowHideState::Done)) {
+  auto p = std::make_shared<std::promise<WindowHideState::Result>>();
+  auto f = p->get_future();
+  (machine.*fn)([p](const WindowHideState::Result& r) { p->set_value(r); });
+  return f;
+}
+
+}  // namespace
+
+TEST(WindowHideState, HideVisibleDrainsAndMinimizes) {
+  Hooks hooks;
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  auto f = Fire(machine, &WindowHideState::Hide);
+  hooks.DrainAll();         // drain: no frames in flight → minimize immediately
+  hooks.RunDeferred();      // complete the (immediate) minimize
+
+  auto r = f.get();
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r.outcome);
+  EXPECT_TRUE(r.parked);
+  EXPECT_TRUE(r.minimized);
+  EXPECT_EQ(1, hooks.park_calls);
+  EXPECT_EQ(1, hooks.minimize_calls);
+  EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+}
+
+TEST(WindowHideState, HideWaitsForInFlightThenMinimizes) {
+  Hooks hooks;
+  hooks.inflight_polls.store(3);  // three frames drain one poll at a time
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  auto f = Fire(machine, &WindowHideState::Hide);
+  hooks.DrainAll();   // 3 polls, then frame_in_flight false → minimize
+
+  auto r = f.get();
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r.outcome);
+  EXPECT_TRUE(r.parked);
+  EXPECT_TRUE(r.minimized);
+  EXPECT_EQ(1, hooks.park_calls);       // parked once, not per frame
+  EXPECT_EQ(1, hooks.minimize_calls);
+  EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+}
+
+TEST(WindowHideState, HideDrainTimeoutStaysParked) {
+  Hooks hooks;
+  hooks.inflight_polls.store(WindowHideState::kDrainAttempts + 5); // never drains
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  auto f = Fire(machine, &WindowHideState::Hide);
+  hooks.DrainAll();   // kDrainAttempts polls then gives up
+
+  auto r = f.get();
+  EXPECT_EQ(WindowHideState::Outcome::kDrainTimeout, r.outcome);
+  EXPECT_TRUE(r.parked);     // still parked — frame production stopped
+  EXPECT_FALSE(r.minimized); // but not minimized
+  EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+  EXPECT_EQ(1, hooks.park_calls);  // park once; polls don't re-park
+  EXPECT_EQ(0, hooks.minimize_calls);  // never reached minimize
+}
