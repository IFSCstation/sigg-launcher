+TEST(WindowHideState, StateNames) {
+  EXPECT_STREQ("visible", WindowHideState::StateName(WindowHideState::State::kVisible));
+  EXPECT_STREQ("hiding", WindowHideState::StateName(WindowHideState::State::kHiding));
+  EXPECT_STREQ("hidden", WindowHideState::StateName(WindowHideState::State::kHidden));
+  EXPECT_STREQ("showing", WindowHideState::StateName(WindowHideState::State::kShowing));
