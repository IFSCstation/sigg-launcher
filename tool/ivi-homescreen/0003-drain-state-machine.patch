+TEST(WindowHideState, ShowHiddenRestoresAndUnparks) {
+  Hooks hooks;
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+  // Enter Hidden.
+  {
+    auto f = Fire(machine, &WindowHideState::Hide);
+    hooks.DrainAll();
+    hooks.RunDeferred();
+    ASSERT_EQ(WindowHideState::Outcome::kOk, f.get().outcome);
+    EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+  }
+
+  auto f = Fire(machine, &WindowHideState::Show);
+  hooks.RunDeferred();   // complete the (immediate) restore
+
+  auto r = f.get();
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r.outcome);
+  EXPECT_FALSE(r.parked);
+  EXPECT_FALSE(r.minimized);
+  EXPECT_EQ(1, hooks.restore_calls);
+  EXPECT_EQ(1, hooks.unpark_calls);
+  EXPECT_EQ(WindowHideState::State::kVisible, machine.GetState());
+}
