+TEST(WindowHideState, DeferredMinimizeSupersededByShow) {
+  Hooks hooks;
+  hooks.defer_minimize = true;  // slow compositor: minimize completes later
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  // Hide starts minimize, deferred.
+  std::promise<WindowHideState::Result> p_hide;
+  auto f_hide = p_hide.get_future();
+  machine.Hide([&p_hide](const WindowHideState::Result& r) { p_hide.set_value(r); });
+  ASSERT_EQ(1, hooks.minimize_calls);
+  ASSERT_EQ(1u, [&] {
+    std::lock_guard<std::mutex> lock(hooks.mu);
+    return hooks.deferred.size();
+  }());
+
+  // Show arrives before minimize confirms: cancels hide, shows immediately.
+  auto f_show = Fire(machine, &WindowHideState::Show);
+  hooks.RunDeferred();   // completes show's restore (immediate)
+  auto r_show = f_show.get();
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r_show.outcome);
+  EXPECT_EQ(WindowHideState::State::kVisible, machine.GetState());
+
+  // The deferred minimize completion is stale (superseded): running it must
+  // not flip the machine back to Hidden or answer the hide waiter with kOk.
+  hooks.RunDeferred();
+  EXPECT_EQ(WindowHideState::State::kVisible, machine.GetState());
+  EXPECT_EQ(WindowHideState::Outcome::kCancelled, f_hide.get().outcome);
+}
