+TEST(WindowHideState, ShowCancelsHiding) {
+  Hooks hooks;
+  hooks.inflight_polls.store(WindowHideState::kDrainAttempts + 5); // never drains
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+
+  // Fire hide: it begins draining but we never Tick, so it stays mid-drain.
+  std::promise<WindowHideState::Result> p_hide;
+  auto f_hide = p_hide.get_future();
+  machine.Hide([&p_hide](const WindowHideState::Result& r) { p_hide.set_value(r); });
+
+  // Show arrives while hiding: cancels the hide and shows.
+  auto f_show = Fire(machine, &WindowHideState::Show);
+  hooks.RunDeferred();   // complete show's (immediate) restore
+
+  auto r_show = f_show.get();
+  auto r_hide = f_hide.get();
+
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r_show.outcome);
+  EXPECT_EQ(WindowHideState::Outcome::kCancelled, r_hide.outcome);
+  EXPECT_EQ(WindowHideState::State::kVisible, machine.GetState());
+}
+
+TEST(WindowHideState, HideCancelsShowing) {
+  Hooks hooks;
+  WindowHideState::Hooks h;
+  hooks.Install(h);
+  WindowHideState machine(h);
+  // Enter Hidden.
+  {
+    auto f = Fire(machine, &WindowHideState::Hide);
+    hooks.DrainAll();
+    hooks.RunDeferred();
+    ASSERT_EQ(WindowHideState::Outcome::kOk, f.get().outcome);
+    EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+  }
+
+  // Fire show with a deferred restore (slow compositor).
+  std::promise<WindowHideState::Result> p_show;
+  auto f_show = p_show.get_future();
+  machine.Show([&p_show](const WindowHideState::Result& r) { p_show.set_value(r); });
+  // restore is deferred: f_show not yet satisfied.
+
+  // Hide supersedes the in-flight show: show waiter gets kCancelled.
+  auto f_hide = Fire(machine, &WindowHideState::Hide);
+  hooks.DrainAll();
+  hooks.RunDeferred();
+
+  auto r_hide = f_hide.get();
+  auto r_show = f_show.get();
+
+  EXPECT_EQ(WindowHideState::Outcome::kOk, r_hide.outcome);
+  EXPECT_EQ(WindowHideState::Outcome::kCancelled, r_show.outcome);
+  EXPECT_EQ(WindowHideState::State::kHidden, machine.GetState());
+}
