+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef SHELL_VIEW_WINDOW_HIDE_STATE_H_
+#define SHELL_VIEW_WINDOW_HIDE_STATE_H_
+
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <vector>
+
+namespace ivi {
+
+/**
+ * @brief State machine behind the sigg_launcher/window channel's hide/show.
+ *
+ *     Visible --hide--> Hiding --drained--> Hidden --show--> Showing
+ *        ^                                                        |
+ *        +---------------------- done ----------------------------+
+ *
+ * Hiding parks vsync first (which stops NEW frames), then waits until no
+ * frame is still in flight (IVsyncProvider::FramesInFlight() == 0), and only
+ * then minimizes the toplevel. That order is the whole point: a frame already
+ * being built when hide arrived would otherwise commit after the window is
+ * gone. The wait is bounded by kDrainTimeoutMs; on expiry the view stays
+ * parked and the caller gets kDrainTimeout rather than a false success.
+ *
+ * Transition rules (all well-defined, all thread-safe):
+ *
+ * - hide() in Visible: starts the hide (park -> drain -> minimize).
+ * - hide() in Hiding:  joins the hide already running; the caller is answered
+ *   when it finishes. No second park, no second drain.
+ * - hide() in Hidden:  no-op, answered immediately with the current result.
+ * - hide() in Showing: supersedes the show. Its waiters are answered
+ *   kCancelled, its in-flight restore completion is ignored (generation
+ *   counter), and a fresh hide starts from wherever the show got to — its
+ *   park/unpark is re-applied from scratch, so the end state is correct
+ *   either way.
+ * - show() in Hidden:  starts the show (restore -> unpark).
+ * - show() in Showing: joins the show already running.
+ * - show() in Hiding:  cancels the hide the same way (waiters get
+ *   kCancelled) and shows. The half-finished hide's park is undone by the
+ *   show's unpark, so this cannot strand the view parked.
+ * - show() in Visible: no-op, answered immediately.
+ *
+ * Every request's callback runs exactly once, unless the transition it joined
+ * was superseded — then kCancelled. Callbacks are invoked outside the lock;
+ * the owner of the hooks must arrange the thread they run on (FlutterView
+ * marshals onto the platform task thread, because the reply has to reach a
+ * flutter::MethodResult there).
+ *
+ * The class is deliberately free of Wayland, Flutter and asio: the hooks are
+ * injected, so the whole machine is unit-testable with no display attached.
+ */
+class WindowHideState {
+ public:
+  enum class State {
+    kVisible,  // running and shown
+    kHiding,   // park/drain/minimize in progress
+    kHidden,   // parked (and minimized, if the compositor supports it)
+    kShowing,  // restore/unpark in progress
+  };
+
+  enum class Outcome {
+    kOk,               // reached the requested end state
+    kDrainTimeout,     // parked, but a frame was still in flight at the
+                       // deadline — NOT minimized (see below)
+    kNotParked,        // parking did not take effect (no vsync provider), so
+                       // frames are still being produced; nothing was hidden
+    kCancelled,        // a later hide/show superseded this request
+    kMinimizeFailed,   // compositor never confirmed minimize (hide)
+    kRestoreFailed,    // compositor never confirmed restore (show)
+  };
+
+  /// What the channel turns into its result map {parked, minimized} plus,
+  /// for anything but kOk, a PlatformException.
+  struct Result {
+    Outcome outcome = Outcome::kOk;
+    bool parked = false;      // vsync is stopped (frames are not being made)
+    bool minimized = false;   // compositor reports our toplevel minimized
+  };
+
+  using Done = std::function<void(Result)>;
+
+  /// Everything the machine needs from the outside world. Called outside the
+  /// machine's lock; async hooks must complete by invoking their callback,
+  /// exactly once, from whatever thread they finish on.
+  struct Hooks {
+    /// Withhold the vsync baton (FlutterView::Hide()).
+    std::function<void()> park;
+    /// Give the baton back (FlutterView::Show()).
+    std::function<void()> unpark;
+    /// True when parking actually stopped frame production. False means no
+    /// wp_presentation provider, so parking was a no-op.
+    std::function<bool()> is_parked;
+    /// True while a frame handed to the engine has not been presented yet.
+    std::function<bool()> frame_in_flight;
+    /// Run @p fn after @p delay_ms, off the caller's stack. Production wires
+    /// this to an asio timer on the platform task thread; tests drive it.
+    std::function<void(int delay_ms, std::function<void()> fn)> schedule;
+    /// Compositor minimize of our toplevel. Reports (ok, minimized).
+    /// Until the foreign-toplevel wiring exists this is an immediate
+    /// (true, false): parked but visibly still on screen, and Dart is told.
+    std::function<void(std::function<void(bool, bool)> done)> minimize;
+    /// Compositor restore of our toplevel. Reports (ok, minimized).
+    std::function<void(std::function<void(bool, bool)> done)> restore;
+  };
+
+  /// How long hide waits for the in-flight frame to be presented before it
+  /// gives up (staying parked). 500 ms is ~30 refreshes at 60 Hz: far longer
+  /// than any single frame, short enough that a wedged compositor cannot
+  /// stall the launcher's hide for long.
+  static constexpr int kDrainTimeoutMs = 500;
+  /// Poll interval for that wait.
+  static constexpr int kDrainPollMs = 5;
+  /// The deadline is attempts x poll interval rather than a wall-clock
+  /// timestamp, so the timeout is reachable in a unit test without
+  /// injecting a clock: kDrainTimeoutMs / kDrainPollMs polls.
+  static constexpr int kDrainAttempts = kDrainTimeoutMs / kDrainPollMs;
+
+  explicit WindowHideState(Hooks hooks);
+  ~WindowHideState() = default;
+
+  WindowHideState(const WindowHideState&) = delete;
+  WindowHideState& operator=(const WindowHideState&) = delete;
+
+  /// Begin (or join) a hide. @p done runs exactly once — with kCancelled if a
+  /// show supersedes it first. Safe from any thread.
+  void Hide(Done done);
+
+  /// Begin (or join) a show. Same contract as Hide(). Safe from any thread.
+  void Show(Done done);
+
+  [[nodiscard]] State GetState() const;
+
+  /// Stable lowercase name for the channel's read-only "state" method.
+  static const char* StateName(State state);
+
+ private:
+  // A waiter plus the result it will be answered with.
+  struct Waiter {
+    Done done;
+    Result result;
+  };
+
+  // Generation of the transition currently in flight. Bumped whenever a new
+  // transition starts or supersedes another, so an async step belonging to a
+  // superseded transition can spot that its answer is stale and drop it.
+  [[nodiscard]] uint64_t CurrentGeneration() const;
+
+  void BeginHide(uint64_t generation);
+  void PollDrain(uint64_t generation, int attempts_left);
+  void FinishHideDrained(uint64_t generation);
+  void FinishHideNoParking(uint64_t generation);
+  void FinishHideDrainTimeout(uint64_t generation);
+  void CompleteHide(uint64_t generation, Result result);
+  void BeginShow(uint64_t generation);
+
+  /// Answer a batch of waiters. Always called with the mutex released: a
+  /// waiter is a channel reply, and running it under the lock would let a
+  /// re-entrant Hide/Show deadlock against it.
+  static void RunWaiters(std::vector<Waiter>& waiters);
+
+  mutable std::mutex mutex_;
+  State state_ = State::kVisible;
+  uint64_t generation_ = 0;
+  std::vector<Waiter> hide_waiters_;
+  std::vector<Waiter> show_waiters_;
+  // Last known compositor/window facts, reported back to every requester.
+  bool parked_ = false;
+  bool minimized_ = false;
+
+  const Hooks hooks_;
+};
+
+}  // namespace ivi
+
+#endif  // SHELL_VIEW_WINDOW_HIDE_STATE_H_
