+void FlutterView::ScheduleOnPlatformThread(const int delay_ms,
+                                           std::function<void()> fn) const {
+  const auto* runner =
+      m_flutter_engine ? m_flutter_engine->GetPlatformTaskRunner() : nullptr;
+  if (runner == nullptr || runner->GetIoContext() == nullptr) {
+    // Nothing to wait on — and with no engine there is no frame in flight
+    // either, so the drain is already over. Run inline rather than leave the
+    // caller's reply unanswered.
+    fn();
+    return;
+  }
+  // The timer lives on the platform thread's io_context, so it fires on the
+  // same thread that processes Flutter platform messages — which is where
+  // the channel's reply has to be sent. The handler keeps the timer alive
+  // through the shared_ptr in its own capture.
+  auto timer = std::make_shared<asio::steady_timer>(*runner->GetIoContext());
+  timer->expires_after(std::chrono::milliseconds(delay_ms));
+  timer->async_wait([timer, fn = std::move(fn)](const asio::error_code& ec) {
+    if (ec) {
+      return;  // canceled or destroyed
+    }
+    fn();
+  });
