+
+#include "shell/view/window_hide_state.h"
+
+#include <utility>
+
+namespace ivi {
+
+WindowHideState::WindowHideState(Hooks hooks) : hooks_(std::move(hooks)) {}
+
+void WindowHideState::RunWaiters(std::vector<Waiter>& waiters) {
+  for (auto& waiter : waiters) {
+    if (waiter.done) {
+      waiter.done(waiter.result);
+    }
+  }
+  waiters.clear();
+}
+
+uint64_t WindowHideState::CurrentGeneration() const {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  return generation_;
+}
+
+WindowHideState::State WindowHideState::GetState() const {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  return state_;
+}
+
+const char* WindowHideState::StateName(const State state) {
+  switch (state) {
+    case State::kVisible:
+      return "visible";
+    case State::kHiding:
+      return "hiding";
+    case State::kHidden:
+      return "hidden";
+    case State::kShowing:
+      return "showing";
+  }
+  return "unknown";
+}
+
+void WindowHideState::Hide(Done done) {
+  std::vector<Waiter> notify;
+  uint64_t generation = 0;
+  bool begin = false;
+
+  {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    switch (state_) {
+      case State::kHidden:
+        // Already hidden: nothing to do, answer with the facts as they are.
+        notify.push_back({std::move(done), Result{Outcome::kOk, parked_, minimized_}});
+        break;
+
+      case State::kHiding:
+        // Join the hide in flight; answered when it resolves.
+        hide_waiters_.push_back({std::move(done), Result{}});
+        break;
+
+      case State::kShowing:
+        // Supersede the show: its waiters are answered kCancelled and the
+        // generation bump invalidates a restore completion still on its way
+        // back from the compositor.
+        for (auto& waiter : show_waiters_) {
+          waiter.result = Result{Outcome::kCancelled, parked_, minimized_};
+        }
+        notify.insert(notify.end(),
+                      std::make_move_iterator(show_waiters_.begin()),
+                      std::make_move_iterator(show_waiters_.end()));
+        show_waiters_.clear();
+        ++generation_;
+        state_ = State::kHiding;
+        generation = ++generation_;
+        hide_waiters_.push_back({std::move(done), Result{}});
+        begin = true;
+        break;
+
+      case State::kVisible:
+        state_ = State::kHiding;
+        generation = ++generation_;
+        hide_waiters_.push_back({std::move(done), Result{}});
+        begin = true;
+        break;
+    }
+  }
+
+  RunWaiters(notify);
+  if (begin) {
+    BeginHide(generation);
+  }
+}
+
+void WindowHideState::Show(Done done) {
+  std::vector<Waiter> notify;
+  uint64_t generation = 0;
+  bool begin = false;
+
+  {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    switch (state_) {
+      case State::kVisible:
+        // Nothing hidden: answer immediately. parked_ reflects reality, so a
+        // caller that raced its own hide still sees the truth.
+        notify.push_back(
+            {std::move(done), Result{Outcome::kOk, parked_, minimized_}});
+        break;
+
+      case State::kShowing:
+        show_waiters_.push_back({std::move(done), Result{}});
+        break;
+
+      case State::kHiding:
+        // Supersede the hide: its waiters are answered kCancelled and the
+        // generation bump stops its drain/minimize steps from landing. Its
+        // park is undone by this show's unpark, so nothing stays parked.
+        for (auto& waiter : hide_waiters_) {
+          waiter.result = Result{Outcome::kCancelled, parked_, minimized_};
+        }
+        notify.insert(notify.end(),
+                      std::make_move_iterator(hide_waiters_.begin()),
+                      std::make_move_iterator(hide_waiters_.end()));
+        hide_waiters_.clear();
+        ++generation_;
+        state_ = State::kShowing;
+        generation = ++generation_;
+        show_waiters_.push_back({std::move(done), Result{}});
+        begin = true;
+        break;
+
+      case State::kHidden:
+        state_ = State::kShowing;
+        generation = ++generation_;
+        show_waiters_.push_back({std::move(done), Result{}});
+        begin = true;
+        break;
+    }
+  }
+
+  RunWaiters(notify);
+  if (begin) {
+    BeginShow(generation);
+  }
+}
+
+void WindowHideState::BeginHide(const uint64_t generation) {
+  if (CurrentGeneration() != generation) {
+    return;  // superseded before we even parked
+  }
+  if (hooks_.park) {
+    hooks_.park();
+  }
+
+  const bool parked = hooks_.is_parked ? hooks_.is_parked() : false;
+  if (!parked) {
+    // No vsync provider: parking is a no-op and frames are still produced.
+    // Report it rather than pretending the window is hidden — and leave the
+    // state Visible, because there is nothing to undo on show.
+    FinishHideNoParking(generation);
+    return;
+  }
+
+  {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    if (generation_ == generation) {
+      parked_ = true;
+    }
+  }
+  PollDrain(generation, kDrainAttempts);
+}
+
+void WindowHideState::PollDrain(const uint64_t generation,
+                                const int attempts_left) {
+  if (CurrentGeneration() != generation) {
+    return;
+  }
+
+  const bool in_flight = hooks_.frame_in_flight && hooks_.frame_in_flight();
+  if (!in_flight) {
+    FinishHideDrained(generation);
+    return;
+  }
+  if (attempts_left <= 0 || !hooks_.schedule) {
+    // Parked, but the last frame never reported a present within the budget.
+    // Stay parked (frame production is stopped either way) and tell the
+    // caller, so it can decide rather than believe the window is hidden.
+    FinishHideDrainTimeout(generation);
+    return;
+  }
+
+  hooks_.schedule(kDrainPollMs, [this, generation, attempts_left] {
+    PollDrain(generation, attempts_left - 1);
+  });
+}
+
+void WindowHideState::FinishHideDrained(const uint64_t generation) {
+  if (CurrentGeneration() != generation) {
+    return;
+  }
+  if (!hooks_.minimize) {
+    CompleteHide(generation, Result{Outcome::kOk, /*parked=*/true,
+                                   /*minimized=*/false});
+    return;
+  }
+  hooks_.minimize([this, generation](const bool ok, const bool minimized) {
+    // The compositor answers on its own thread; re-check we still own the
+    // transition (a show may have arrived while we waited for it).
+    CompleteHide(generation,
+                 Result{ok ? Outcome::kOk : Outcome::kMinimizeFailed,
+                        /*parked=*/true, minimized});
+  });
+}
+
+void WindowHideState::FinishHideDrainTimeout(const uint64_t generation) {
+  // Still Hidden rather than Visible: the view IS parked, and a show must
+  // unpark it. Reporting kDrainTimeout (and minimized=false) is how the
+  // caller learns the hide was not clean.
+  CompleteHide(generation, Result{Outcome::kDrainTimeout, /*parked=*/true,
+                                 /*minimized=*/false});
+}
+
+void WindowHideState::FinishHideNoParking(const uint64_t generation) {
+  std::vector<Waiter> notify;
+  {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    if (generation_ != generation) {
+      return;
+    }
+    parked_ = false;
+    minimized_ = false;
+    state_ = State::kVisible;  // nothing was hidden
+    notify.swap(hide_waiters_);
+    for (auto& waiter : notify) {
+      waiter.result = Result{Outcome::kNotParked, /*parked=*/false,
+                            /*minimized=*/false};
+    }
+  }
+  RunWaiters(notify);
+}
+
+void WindowHideState::CompleteHide(const uint64_t generation,
+                                   const Result result) {
+  std::vector<Waiter> notify;
+  {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    if (generation_ != generation) {
+      return;  // a show (or a fresh hide) superseded us; it owns the state
+    }
+    parked_ = result.parked;
+    minimized_ = result.minimized;
+    state_ = State::kHidden;
+    notify.swap(hide_waiters_);
+    for (auto& waiter : notify) {
+      waiter.result = result;
+    }
+  }
+  RunWaiters(notify);
+}
+
+void WindowHideState::BeginShow(const uint64_t generation) {
+  if (CurrentGeneration() != generation) {
+    return;
+  }
+
+  // Restore first, then unpark: showing a window whose frames are still
+  // withheld would leave it black until something else scheduled a frame.
+  const auto finish = [this, generation](const bool ok, const bool minimized) {
+    if (CurrentGeneration() != generation) {
+      return;  // superseded while the compositor was answering
+    }
+    if (hooks_.unpark) {
+      hooks_.unpark();
+    }
+    // False only if parking had no effect to begin with (no provider), in
+    // which case frames were never stopped — which is what !parked reports.
+    const bool parked = hooks_.is_parked ? hooks_.is_parked() : false;
+
+    std::vector<Waiter> notify;
+    {
+      const std::lock_guard<std::mutex> lock(mutex_);
+      if (generation_ != generation) {
+        return;
+      }
+      parked_ = parked;
+      minimized_ = minimized;
+      state_ = State::kVisible;
+      notify.swap(show_waiters_);
+      for (auto& waiter : notify) {
+        waiter.result = Result{ok ? Outcome::kOk : Outcome::kRestoreFailed,
+                               parked, minimized};
+      }
+    }
+    RunWaiters(notify);
+  };
+
+  if (!hooks_.restore) {
+    finish(/*ok=*/true, /*minimized=*/false);
+    return;
+  }
+  hooks_.restore(finish);
+}
+
+}  // namespace ivi
