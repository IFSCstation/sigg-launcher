+             observed, observed - 1, std::memory_order_acq_rel,
+             std::memory_order_acquire)) {
+    // compare_exchange_weak reloaded observed; retry until it hits 0 or wins.
+  }
 }
 
 void IVsyncProvider::Stop() {
+  // There is no frame left to wait for once the source is gone; a stale count
+  // would make a later drain-timeout fire for nothing.
+  frames_in_flight_.store(0, std::memory_order_release);
   // Unanswered baton is a documented leak, not a crash — Flutter is shutting
   // down. Clearing engine/runner makes any late source event a no-op.
   vsync_baton_.store(0, std::memory_order_release);
