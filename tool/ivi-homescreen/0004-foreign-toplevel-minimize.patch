+#include <vector>
+
+#include <wayland-client.h>
+
+#include <wl/wl_ptr.hpp>
+
+#include "foreign_toplevel_management_client.hpp"  // generated
+
+struct wl_registry;
+struct wl_seat;
+
+namespace ivi {
+
+namespace ftc = wlr_foreign_toplevel_management_unstable_v1::client;
+
+/**
+ * @brief Client side of `zwlr_foreign_toplevel_manager_v1`.
+ *
+ * Used only for the minimize/restore subset: visually hide the launcher's own
+ * toplevel while a game subprocess runs, then unminimize + activate it on exit.
+ * A null-buffer unmap is the wrong primitive (wlroots disconnects a client that
+ * commits null without a reconfigure/ack cycle; xdg_toplevel state is lost).
+ *
+ * Threading: TryBindGlobal and all protocol events run on the Wayland reactor
+ * thread. minimize()/restore() are posted there by callers. set_app_id() may
+ * come from the platform thread; minimized() is read from the platform thread;
+ * those two take the mutex. Wayland requests never run on the raster/platform
+ * thread directly.
+ *
+ * Runtime-optional: when the compositor does not advertise the global,
+ * bound() is false and callers report minimized=false (parked, still visible).
+ */
+class ForeignToplevelClient {
+ public:
+  ForeignToplevelClient() = default;
+  ~ForeignToplevelClient();
+
+  ForeignToplevelClient(const ForeignToplevelClient&) = delete;
+  ForeignToplevelClient& operator=(const ForeignToplevelClient&) = delete;
+
+  [[nodiscard]] bool TryBindGlobal(wl_registry* registry,
+                                   uint32_t name,
+                                   std::string_view interface,
+                                   uint32_t version);
+
+  void set_app_id(std::string_view app_id);
+
+  [[nodiscard]] bool bound() const { return manager_.Get() != nullptr; }
+
+  /// Minimize our toplevel. No-op with warning when no unambiguous handle.
+  /// Must run on the Wayland thread.
+  void minimize();
+
+  /// Unminimize + activate our toplevel (activate skipped when seat is null).
+  /// Must run on the Wayland thread.
+  void restore(wl_seat* seat);
+
+  /// Last compositor-reported minimized state for OUR toplevel. Any thread.
+  [[nodiscard]] bool minimized() const;
+
+  /// Destroy manager + handles. Must run before wl_display_disconnect.
+  void Reset();
+
+ private:
+  // Concrete manager CRTP (CZwlrForeignToplevelManagerV1 is a template).
+  class Manager final
+      : public ftc::CZwlrForeignToplevelManagerV1<Manager> {
+   public:
+    void OnToplevel(wl_proxy* toplevel) override;
+    void OnFinished() override;
+    ForeignToplevelClient* owner = nullptr;
+  };
+
+  void OnToplevel(wl_proxy* toplevel);
+  void OnFinished();
+  void SweepClosed();
+  [[nodiscard]] bool is_ours(std::string_view app_id) const;
+
+  // Handle must be complete here: std::map<unique_ptr<Handle>> needs sizeof.
+  struct Handle final : public ftc::CZwlrForeignToplevelHandleV1<Handle> {
+    ForeignToplevelClient* owner = nullptr;
+    std::string app_id;
+    bool minimized = false;
+    bool closed = false;
+
+    void OnAppId(const char* id) override { app_id = id != nullptr ? id : ""; }
+
+    void OnState(wl_array* state) override {
+      bool is_minimized = false;
+      if (state != nullptr && state->size >= sizeof(uint32_t)) {
+        const auto* data = static_cast<const uint32_t*>(state->data);
+        const size_t n = state->size / sizeof(uint32_t);
+        for (size_t i = 0; i < n; ++i) {
+          if (data[i] == static_cast<uint32_t>(
+                             ftc::ZwlrForeignToplevelHandleV1State::Minimized)) {
+            is_minimized = true;
+            break;
+          }
+        }
+      }
+      minimized = is_minimized;
+      if (owner != nullptr && owner->is_ours(app_id)) {
+        const std::lock_guard<std::mutex> lock(owner->mu_);
+        owner->minimized_ = is_minimized;
+      }
+    }
+
+    void OnClosed() override {
+      closed = true;
+      if (owner != nullptr && GetProxy() != nullptr) {
+        owner->closed_.push_back(GetProxy());
+      }
+    }
+  };
+
+  [[nodiscard]] Handle* our_handle();
+
+  wl::WlPtr<Manager> manager_;
+  std::map<wl_proxy*, std::unique_ptr<Handle>> handles_;  // Wayland thread
+  std::vector<wl_proxy*> closed_;                         // Wayland thread
+
+  mutable std::mutex mu_;
+  std::string app_id_;
+  bool minimized_ = false;
+};
+
+}  // namespace ivi
+
+#endif  // SHELL_WAYLAND_FOREIGN_TOPLEVEL_CLIENT_H_
diff --git a/shell/wayland/protocols/wlr-foreign-toplevel-management-unstable-v1.xml b/shell/wayland/protocols/wlr-foreign-toplevel-management-unstable-v1.xml
