+void FlutterView::AwaitToplevelState(const bool want_minimized,
+                                     const int attempts_left,
+                                     std::function<void(bool, bool)> done) {
+  Display* display = GetDisplay();
+  auto* ftc = display != nullptr ? display->foreign_toplevel() : nullptr;
+  if (ftc == nullptr || !ftc->bound()) {
+    done(true, false);  // global absent: park succeeded, not minimized
+    return;
+  }
+  if (ftc->minimized() == want_minimized) {
+    done(true, want_minimized);
+    return;
+  }
+  if (attempts_left <= 0) {
+    ihs::log::warn(
+        "[ForeignToplevel] {} not confirmed by the compositor",
+        want_minimized ? "minimize" : "restore");
+    done(false, ftc->minimized());
+    return;
+  }
+  if (attempts_left % kToplevelRetryEvery == 0) {
+    if (auto* ioc = display->GetIoContext()) {
+      asio::post(*ioc, [ftc, display, want_minimized] {
+        if (want_minimized) {
+          ftc->minimize();
+        } else {
+          ftc->restore(display->GetSeat());
+        }
+        display->FlushRequests();
+      });
+    } else {
+      done(false, ftc->minimized());
+      return;
+    }
+  }
+  ScheduleOnPlatformThread(
+      kToplevelPollMs, [this, want_minimized, attempts_left,
+                        done = std::move(done)]() mutable {
+        AwaitToplevelState(want_minimized, attempts_left - 1, std::move(done));
+      });
+}
