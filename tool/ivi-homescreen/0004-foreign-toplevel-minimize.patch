+#include "wayland/foreign_toplevel_client.h"
+
+#include <algorithm>
+
+#include <wayland-client.h>
+
+#include <wl/proxy_impl.hpp>
+
+#include "logging/logging.h"
+
+namespace ivi {
+
+namespace ftc = wlr_foreign_toplevel_management_unstable_v1::client;
+
+ForeignToplevelClient::~ForeignToplevelClient() {
+  Reset();
+}
+
+bool ForeignToplevelClient::TryBindGlobal(wl_registry* registry,
+                                          const uint32_t name,
+                                          const std::string_view interface,
+                                          const uint32_t version) {
+  if (interface !=
+      ftc::zwlr_foreign_toplevel_manager_v1_traits::interface_name) {
+    return false;
+  }
+  if (manager_.Get() != nullptr) {
+    return true;
+  }
+  const uint32_t bind_ver = std::min(
+      version, ftc::zwlr_foreign_toplevel_manager_v1_traits::version);
+  auto* raw = static_cast<wl_proxy*>(wl_registry_bind(
+      registry, name,
+      &ftc::zwlr_foreign_toplevel_manager_v1_traits::wl_iface(), bind_ver));
+  if (raw == nullptr) {
+    ihs::log::warn("[ForeignToplevel] manager bind failed");
+    return true;
+  }
+  manager_.Get()->owner = this;
+  manager_.Get()->_SetProxy(raw);
+  ihs::log::debug(
+      "[ForeignToplevel] bound zwlr_foreign_toplevel_manager_v1 v{}",
+      bind_ver);
+  return true;
+}
+
+void ForeignToplevelClient::set_app_id(const std::string_view app_id) {
+  const std::lock_guard<std::mutex> lock(mu_);
+  app_id_ = app_id;
+}
+
+bool ForeignToplevelClient::is_ours(const std::string_view app_id) const {
+  const std::lock_guard<std::mutex> lock(mu_);
+  return !app_id_.empty() && app_id == app_id_;
+}
+
+void ForeignToplevelClient::OnToplevel(wl_proxy* toplevel) {
+  SweepClosed();
+  if (toplevel == nullptr) {
+    return;
+  }
+  auto handle = std::make_unique<Handle>();
+  handle->owner = this;
+  auto& slot = handles_[toplevel];
+  slot = std::move(handle);
+  slot->_SetProxy(toplevel);
+  ihs::log::debug("[ForeignToplevel] toplevel handle {} created",
+                  reinterpret_cast<const void*>(toplevel));
+}
+
+void ForeignToplevelClient::OnFinished() {
+  ihs::log::debug("[ForeignToplevel] manager finished");
+  Reset();
+}
+
+void ForeignToplevelClient::SweepClosed() {
+  if (closed_.empty()) {
+    return;
+  }
+  for (wl_proxy* proxy : closed_) {
+    auto it = handles_.find(proxy);
+    if (it == handles_.end()) {
+      continue;
+    }
+    const bool was_ours = is_ours(it->second->app_id);
+    wl_proxy_destroy(proxy);
+    handles_.erase(it);
+    if (was_ours) {
+      const std::lock_guard<std::mutex> lock(mu_);
+      minimized_ = false;
+    }
+  }
+  closed_.clear();
+}
+
+ForeignToplevelClient::Handle* ForeignToplevelClient::our_handle() {
+  SweepClosed();
+
+  std::string wanted;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    wanted = app_id_;
+  }
+  if (wanted.empty()) {
+    return nullptr;
+  }
+
+  Handle* match = nullptr;
+  int matches = 0;
+  for (auto& [proxy, handle] : handles_) {
+    if (handle->app_id == wanted) {
+      ++matches;
+      match = handle.get();
+    }
+  }
+  if (matches == 0) {
+    return nullptr;
+  }
+  if (matches > 1) {
+    ihs::log::error(
+        "[ForeignToplevel] {} toplevels match app_id='{}'; refusing to pick one",
+        matches, wanted);
+    for (auto& [proxy, handle] : handles_) {
+      if (handle->app_id == wanted) {
+        ihs::log::debug(
+            "[ForeignToplevel] candidate handle {} app_id='{}' minimized={}",
+            reinterpret_cast<const void*>(handle.get()), handle->app_id,
+            handle->minimized);
+      }
+    }
+    return nullptr;
+  }
+  return match;
+}
+
+void ForeignToplevelClient::minimize() {
+  if (auto* handle = our_handle()) {
+    ihs::log::debug("[ForeignToplevel] minimize app_id='{}'", handle->app_id);
+    handle->SetMinimized();
+  } else {
+    ihs::log::warn("[ForeignToplevel] minimize: no unambiguous toplevel");
+  }
+}
+
+void ForeignToplevelClient::restore(wl_seat* seat) {
+  if (auto* handle = our_handle()) {
+    ihs::log::debug("[ForeignToplevel] restore app_id='{}'", handle->app_id);
+    handle->UnsetMinimized();
+    if (seat != nullptr) {
+      handle->Activate(reinterpret_cast<wl_proxy*>(seat));
+    }
+  } else {
+    ihs::log::warn("[ForeignToplevel] restore: no unambiguous toplevel");
+  }
+}
+
+bool ForeignToplevelClient::minimized() const {
+  const std::lock_guard<std::mutex> lock(mu_);
+  return minimized_;
+}
+
+void ForeignToplevelClient::Reset() {
+  for (auto& [proxy, handle] : handles_) {
+    (void)handle;
+    // Compositor owns handle lifetime, but client proxy must be destroyed.
+    wl_proxy_destroy(proxy);
+  }
+  handles_.clear();
+  for (wl_proxy* proxy : closed_) {
+    wl_proxy_destroy(proxy);
+  }
+  closed_.clear();
+  if (manager_.Get() != nullptr) {
+    manager_.Get()->Stop();
+    manager_.Reset();
+  }
+  const std::lock_guard<std::mutex> lock(mu_);
+  minimized_ = false;
+}
+
+void ForeignToplevelClient::Manager::OnToplevel(wl_proxy* toplevel) {
+  if (owner != nullptr) {
+    owner->OnToplevel(toplevel);
+  }
+}
+
+void ForeignToplevelClient::Manager::OnFinished() {
+  if (owner != nullptr) {
+    owner->OnFinished();
+  }
+}
+
+}  // namespace ivi
